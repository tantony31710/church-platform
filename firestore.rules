rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ---- Helpers ---------------------------------------------------
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    // Role lives on the user's own doc. Reading it costs one extra
    // get() per rule check, but keeps role logic in one place instead
    // of duplicating custom claims setup right now.
    function isAdmin() {
      return isSignedIn() &&
        request.auth.token.keys().hasAll(['admin', 'email_verified']) &&
        request.auth.token.admin == true &&
        request.auth.token.email_verified == true &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    // ---- users -------------------------------------------------------
    match /users/{userId} {
      // Volunteers read only their own private profile. Admins can read
      // the full roster for assignment and administration screens.
      allow read: if isAdmin() || isOwner(userId);

      // Users can only create their own doc (on signup), and can only
      // ever create it once — not overwrite an existing profile.
      allow create: if isOwner(userId) &&
        request.resource.data.role == 'volunteer' &&
        request.resource.data.points == 0 &&
        request.resource.data.tasksCompletedCount == 0;

      // Users can update their own profile fields, but NEVER points.
      // Points only change via Cloud Functions using the Admin SDK,
      // which bypasses these rules entirely.
      allow update: if isOwner(userId) &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'name', 'skills', 'avatar', 'department', 'phone'
        ]);

      // Roles, points, counters, and badges are changed only by the
      // trusted Admin SDK in bootstrap and Cloud Functions. The client,
      // including the administrator browser, cannot mutate them directly.
      allow delete: if isAdmin();
    }

    // ---- tasks -------------------------------------------------------
    match /tasks/{taskId} {
      allow read: if isSignedIn();

      // Only admins/leaders create and delete tasks.
      allow create, delete: if isAdmin();

      // Admins manage tasks. Volunteers may claim an open task or complete/
      // update subtasks on a task assigned to themselves, but cannot change
      // the task value, title, owner, or arbitrary fields.
      allow update: if isAdmin() || (
        isSignedIn() &&
        resource.data.status == 'open' &&
        request.resource.data.assignedTo == request.auth.uid &&
        request.resource.data.status == 'assigned' &&
        request.resource.data.title == resource.data.title &&
        request.resource.data.pointsValue == resource.data.pointsValue &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'status', 'assignedTo', 'assignedToName'
        ])
      ) || (
        isSignedIn() &&
        resource.data.assignedTo == request.auth.uid &&
        request.resource.data.assignedTo == resource.data.assignedTo &&
        request.resource.data.assignedToName == resource.data.assignedToName &&
        request.resource.data.pointsValue == resource.data.pointsValue &&
        request.resource.data.title == resource.data.title &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'status', 'subtasks', 'completedAt', 'completedBy'
        ]) &&
        (request.resource.data.status == resource.data.status ||
          (resource.data.status == 'assigned' && request.resource.data.status == 'completed'))
      );

      // Comments sub-collection
      match /comments/{commentId} {
        allow read: if isSignedIn();
        allow create: if isSignedIn() && request.resource.data.userId == request.auth.uid;
        allow delete: if isSignedIn() && (request.auth.uid == resource.data.userId || isAdmin());
      }
    }

    // ---- attendance ----------------------------------------------------
    match /attendance/{recordId} {
      // Volunteers can only see their own attendance history.
      // Admins can see everyone's, for the Insights tab.
      allow read: if isAdmin() || (isSignedIn() && resource.data.userId == request.auth.uid);

      // A volunteer can only mark THEIR OWN attendance, and attendance
      // never awards points.
      allow create: if isSignedIn() &&
        request.resource.data.userId == request.auth.uid &&
        request.resource.data.pointsAwarded == 0;

      allow update, delete: if isAdmin();
    }

    // ---- leaderboard (denormalized, function-maintained) -----------
    match /leaderboard/{userId} {
      // Anyone can read the leaderboard.
      allow read: if isSignedIn();

      // No client writes at all. This collection is only ever written
      // by Cloud Functions via the Admin SDK, which ignores these
      // rules. If a write ever succeeds here from the browser, that's
      // a bug to fix immediately.
      allow write: if false;
    }

    // ---- settings -----------------------------------------------------
    match /settings/{settingId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    // ---- managed development rosters --------------------------------
    // Roster and knowledge records are administrator-managed operational data.
    // They are intentionally separate from users/tasks/attendance so fixture
    // records can be isolated and removed without changing production users.
    match /rosters/{rosterId} {
      allow read, write: if isAdmin();
    }

    match /roster_members/{memberId} {
      allow read, write: if isAdmin();
    }

    match /knowledge_documents/{documentId} {
      allow read, write: if isAdmin();
    }

    // ---- model_benchmarks -------------------------------------------
    match /model_benchmarks/{benchmarkId} {
      allow read, write: if isAdmin();
    }

    // Optional administrator-only operational documents.
    match /admin-data/{docId} {
      allow read, write: if isAdmin();
    }
  }
}
