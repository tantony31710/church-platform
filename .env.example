VITE_FIREBASE_API_KEY=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
# Optional when the static Vercel client calls a separately deployed API.
# Leave blank when Express serves the frontend from the same origin.
VITE_API_BASE_URL=
# Comma-separated approved administrator emails. Use one value to keep single-admin mode.
VITE_ADMIN_EMAILS=
# Legacy single-admin fallback; use VITE_ADMIN_EMAILS for multiple admins.
VITE_ADMIN_EMAIL=
# Server-side allowlist. Do not use VITE_ for this value.
ADMIN_EMAILS=
# Legacy single-admin fallback; use ADMIN_EMAILS for multiple admins.
ADMIN_EMAIL=
# Or use FIREBASE_PROJECT_ID, FIREBASE_CLIENT_EMAIL, and FIREBASE_PRIVATE_KEY.
FIREBASE_SERVICE_ACCOUNT=
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
# Comma-separated exact browser origins allowed to call the API from a different origin.
CORS_ORIGINS=https://church-platform-zeta.vercel.app,http://localhost:5173
