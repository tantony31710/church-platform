{
  "name": "church-platform",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx server.ts",
    "build": "vite build && esbuild server.ts --bundle --platform=node --format=cjs --packages=external --sourcemap --outfile=dist/server.cjs",
    "start": "node dist/server.cjs",
    "preview": "vite preview --host 0.0.0.0 --port 3000",
    "lint": "tsc --noEmit",
    "firebase:emulators": "firebase emulators:start --only firestore,functions --project church-platform-local",
    "test:points:emulator": "GCLOUD_PROJECT=church-platform-local FIRESTORE_EMULATOR_HOST=127.0.0.1:8080 tsx scripts/test-points-emulator.ts",
    "test:rules:emulator": "FIRESTORE_EMULATOR_HOST=127.0.0.1:8080 FIREBASE_EMULATOR_HUB=127.0.0.1:4400 tsx scripts/test-firestore-rules.ts"
  },
  "dependencies": {
    "@google/genai": "^2.18.0",
    "@react-three/drei": "^9.111.0",
    "@react-three/fiber": "^8.17.0",
    "@types/canvas-confetti": "^1.9.0",
    "canvas-confetti": "^1.9.4",
    "class-variance-authority": "^0.7.0",
    "clsx": "^2.1.1",
    "d3": "^7.9.0",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "express-rate-limit": "^8.6.2",
    "firebase": "^12.15.0",
    "firebase-admin": "^14.3.0",
    "framer-motion": "^11.5.0",
    "lucide-react": "^0.436.0",
    "qrcode.react": "^3.1.0",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-router-dom": "^7.18.2",
    "recharts": "^2.12.0",
    "tailwind-merge": "^2.5.0",
    "three": "^0.167.0",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^5.0.2",
    "@types/d3": "^7.4.3",
    "@types/express": "^5.0.6",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "@types/three": "^0.167.0",
    "@vitejs/plugin-react": "^4.3.0",
    "autoprefixer": "^10.4.0",
    "esbuild": "^0.28.2",
    "firebase-tools": "^15.28.1",
    "postcss": "^8.4.0",
    "tailwindcss": "^3.4.0",
    "tsx": "^4.23.12",
    "typescript": "^5.5.0",
    "vite": "^5.4.0"
  },
  "overrides": {
    "react": "18.3.1",
    "react-dom": "18.3.1"
  }
}
